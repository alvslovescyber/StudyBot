# StudyBot server environment — spec §3.10b.
#
# Copy to a 0600 file OUTSIDE the repo (for example /etc/studybot/env) and
# fill in the values there. Every key is listed here and every value is blank.
# Nothing in this file is read by the app; it exists so the full set of keys
# is visible and reviewable.

# Storage
STUDYBOT_DB_PATH=
STUDYBOT_BLOB_PATH=

# Pairing — used to sign the six-word pairing codes (§3.6)
STUDYBOT_PAIRING_SECRET=

# AI proxy (§3.7). Without OPENAI_API_KEY the server answers from a canned provider.
OPENAI_API_KEY=
OPENAI_MODEL=                        # default gpt-4o-mini
AI_MONTHLY_CAP_PENCE=                # default 800 (£8); 402 at the cap, warning flag from 80%
AI_INPUT_PENCE_PER_MILLION_TOKENS=   # default 12; integers, rounded up per run
AI_OUTPUT_PENCE_PER_MILLION_TOKENS=  # default 48
RATE_LIMIT_PER_MINUTE=               # default 60 per device
AI_RATE_LIMIT_PER_MINUTE=            # default 10 per device

# ELE2 / Moodle ingestion (§8.1)
ELE2_BASE_URL=
ELE2_TOKEN=
ELE2_ICS_URL=

# Microsoft Graph — university mail, OneNote, calendar, files (§8.2, §8.5)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=
MS_REFRESH_TOKEN=

# GitHub — fine-grained, read-only (§8.9)
GITHUB_TOKEN=

# Sunday digest email (§8.6). Use SMTP_* or RESEND_API_KEY, not both.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=

# Litestream replica bucket (§3.11)
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Logging. No user content is ever logged, at any level (§3.10).
LOG_LEVEL=
